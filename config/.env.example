# [한걸음씩] 자동화 시스템 환경 변수 설정 샘플
# .env 파일로 복사하여 실제 값을 입력하세요.

# Google Cloud Project 정보
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here

# YouTube API 키 (데이터 조회용)
YOUTUBE_API_KEY=your_api_key_here

# Google Sheets 관련 (Command Center)
# 브라우저 주소창에서 확인 가능: https://docs.google.com/spreadsheets/d/[이부분이_ID]/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Drive 관련 폴더 ID
# 1. 영상 소스 폴더 (VEO 생성물 등)
DRIVE_SOURCE_FOLDER_ID=your_folder_id_here
# 2. 편집 완료 영상 업로드 폴더
DRIVE_EDITED_FOLDER_ID=your_folder_id_here

# 채널 정보
YOUTUBE_CHANNEL_ID=your_channel_id_here

# 기타 설정
LOG_LEVEL=INFO
