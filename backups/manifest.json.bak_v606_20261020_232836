{
  "manifest_version": 3,
  "name": "RGON Omni-Link Hub (르곤 AI 만능 소통창)",
  "version": "6.0.6",
  "description": "르곤 독대실 ⇄ Claude Opus 5.5 ⇄ GPT-6.1 Sol ⇄ Grok 4.7 ⇄ Google Sheets ⇄ Adobe 멀티탭 신경망 허브",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "clipboardWrite",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "✨ 르곤 만능 소통창 열기/닫기"
  },
  "commands": {
    "toggle-omni": {
      "suggested_key": {
        "default": "Alt+Shift+O"
      },
      "description": "르곤 만능 소통창 패널 열기/닫기"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_aside_bar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}